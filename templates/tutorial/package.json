{
  "name": "tutorial",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "bun build",
    "dev": "bun run src/index.ts",
    "preview": "astro preview",
    "start": "astro dev",
    "postbuild": "cp _headers ./dist/",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "scan": "ast-grep scan",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "@tutorialkit/react": "1.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "5.0.6",
    "@tutorialkit/astro": "1.6.0",
    "@tutorialkit/theme": "1.6.0",
    "@tutorialkit/types": "1.6.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "astro": "6.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
