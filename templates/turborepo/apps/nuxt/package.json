    "@unocss/nuxt": "^66.7.0",
    "@vue-macros/nuxt": "^3.1.2",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.6",
    "nuxt-mcp-dev": "^0.3.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "oxlint-tsgolint": "^0.10.1",
    "vite-plugin-checker": "^0.12.0",
    "vue-tsc": "^3.3.2",
