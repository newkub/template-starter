{
  "name": "@workspace/vscode-extensions",
  "displayName": "VSCode Extension",
  "description": "My awesome VSCode extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "watch": "bun --watch verify",
    "dev": "bun run src/index.ts",
    "format": "biome check --write",
    "lint": "biome check",
    "build": "bun build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "package": "vsce package",
    "publish": "vsce publish",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "reactive-vscode": "^1.0.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
