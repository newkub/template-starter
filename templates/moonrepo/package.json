{
  "name": "moonrepo-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "watch": "moon run watch",
    "prepare": "bunx lefthook install",
    "dev": "bun run src/index.ts",
    "build": "bun build",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check",
    "lint:direct": "oxlint --fix",
    "format": "biome check --write",
    "format:direct": "dprint fmt",
    "clean": "moon run clean && bunx rimraf node_modules",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "ci": "bun run verify && bun run build"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1.41.7",
    "dprint": "^0.51.1",
    "lefthook": "^2.1.6",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.10.1",
    "rimraf": "^6.1.3"
  }
}
