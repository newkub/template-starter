{
  "name": "user-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build",
    "start": "bun dist/index.js",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "clean": "rimraf dist",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.12.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
