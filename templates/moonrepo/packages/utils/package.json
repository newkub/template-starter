{
  "name": "@moonrepo/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write",
    "clean": "rimraf dist",
    "dev": "bun run src/index.ts",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "@moonrepo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
