{
  "name": "@wrikka/node-lib",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "watch": "bun --watch verify",
    "dev": "bun run src/index.ts",
    "format": "biome check --write",
    "lint": "biome check",
    "build": "bun build",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "effect": "^3.21.2",
    "zod": "^3.25.76"
  }
}
