{
  "name": "vitepress",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "prepare": "bunx lefthook install",
    "watch": "vitepress dev docs --watch",
    "dev": "bun run src/index.ts",
    "build": "bun build",
    "preview": "vitepress preview docs",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "check": "bunx oxlint --fix && tsc --noEmit && bunx vue-tsc --noEmit && bunx knip",
    "typecheck": "tsgo --noEmit",
    "scan": "ast-grep scan",
    "ci": "bun run verify && bun run build"
  },
  "dependencies": {
    "@clerk/vue": "^1.17.21",
    "@kitbag/router": "^0.21.0",
    "@shikijs/types": "^3.23.0",
    "@stackblitz/sdk": "^1.11.0",
    "@supabase/supabase-js": "^2.105.4",
    "markdown-it": "^14.1.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@shikijs/vitepress-twoslash": "^3.23.0",
    "@types/bun": "^1.3.13",
    "@types/markdown-it-container": "^2.0.11",
    "dprint": "^0.51.1",
    "markdown-it-mathjax3": "^5.2.0",
    "medium-zoom": "^1.1.0",
    "unocss": "^66.6.8",
    "unocss-preset-scrollbar": "^3.2.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-sandpack": "^1.1.4"
  }
}
