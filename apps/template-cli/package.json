{
	"name": "@templates/template-cli",
	"version": "1.0.0",
	"description": "CLI to scaffold, view, and manage project templates",
	"keywords": [
		"cli",
		"templates",
		"scaffold"
	],
	"author": "Wrikka",
	"license": "MIT",
	"type": "module",
	"private": false,
	"bin": {
		"templates": "./dist/main.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"dev": "bunx bunup --watch",
		"build": "bunx bunup",
		"start": "bun run src/main.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"verify": "bun run typecheck && bun run lint && bun run test",
		"ci": "bun run verify && bun run build"
	},
	"dependencies": {
		"cac": "^6.7.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"@types/node": "^22.10.5",
		"bunup": "^0.2.1",
		"typescript": "^5.7.3"
	}
}
